{
  "name": "pi-package-template",
  "version": "0.1.0",
  "description": "A Pi extension.",
  "license": "MIT",
  "author": "JangMan-J",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JangMan-J/pi-package-template.git"
  },
  "homepage": "https://github.com/JangMan-J/pi-package-template#readme",
  "bugs": {
    "url": "https://github.com/JangMan-J/pi-package-template/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "init-package": "node scripts/init-package.mjs",
    "bootstrap:npm": "bash scripts/npm-bootstrap.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "~26.6.5",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "overrides": {
    "undici": "8.12.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
